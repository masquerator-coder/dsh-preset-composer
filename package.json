{
  "name": "dsh-preset-composer",
  "description": "Host-only custom agent preset editor via the /preset-composer slash command: name, description, preset prompt, skills, and plugins. A client UI (child-slot configure button) is reserved for future DSH support of out-of-tree client bundles.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsdown": "^0.23.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "react": "^18.2.0",
    "@types/react": "~18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
